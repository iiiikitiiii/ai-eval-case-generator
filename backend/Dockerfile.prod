# 生产镜像——跟 backend/Dockerfile（本地全容器化开发用，装了 --reload、
# 挂载源码目录）分开维护，不要合并成一个靠 build arg 切换的 Dockerfile：
# 开发和生产的失败模式不一样，混在一起容易改动一边影响另一边。

# ---- 构建阶段：装依赖，含编译工具链 ----
FROM python:3.12-slim AS builder

WORKDIR /srv

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ---- 运行阶段：只带运行时需要的东西，非 root 用户 ----
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 appuser

WORKDIR /srv
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local
COPY --chown=appuser:appuser . .
RUN chmod +x /srv/docker-entrypoint.sh

USER appuser
ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# 迁移在容器启动时跑一次再起服务——docker-compose.prod.yml 里 backend 和
# worker 两个服务都用这个镜像，都走这条 entrypoint；alembic upgrade head
# 是幂等的（没有待应用的迁移就直接返回），两个服务同时启动重复跑一次
# 没有副作用，不需要额外协调"只跑一次"。真正的建表/种子数据是首次部署
# 单独执行的手动步骤，见 doc/内部部署指南.md，不在这里自动做——避免
# 每次重启容器都可能因为种子脚本的意外行为悄悄改动数据。
ENTRYPOINT ["/srv/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
