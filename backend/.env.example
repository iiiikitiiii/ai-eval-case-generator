# 本地非 Docker 开发用（例如只用 docker-compose 起 postgres/redis/minio，
# 后端在宿主机上跑 venv，方便调试）。复制为 backend/.env。
# 全容器化跑（推荐日常开发）时改用 infra/.env，见 infra/.env.example。

DATABASE_URL=postgresql+psycopg2://caseflow:caseflow@localhost:5432/caseflow
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=caseflow
S3_SECRET_KEY=caseflow-secret
S3_BUCKET=case-documents
S3_SECURE=false

CORS_ORIGINS=["http://localhost:5173"]

LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# Kimi K3（Moonshot），跟 MiniMax 二选一，运行时可在 Prompt 后台页面切换
# （app_settings 表，不用改这里重启），这里只是启动兜底默认值
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low

# 备用后端，把 LLM_PROVIDER 改成 anthropic 即可切过去，agent 代码不用改
ANTHROPIC_API_KEY=
