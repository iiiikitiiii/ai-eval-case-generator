# 复制为 infra/.env 后按需修改。docker-compose.yml 会自动加载它，并覆盖
# 其中几个字段（DATABASE_URL/REDIS_URL/S3_ENDPOINT 走容器内网地址）。

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

S3_ACCESS_KEY=caseflow
S3_SECRET_KEY=caseflow-secret
S3_BUCKET=case-documents
S3_SECURE=false

CORS_ORIGINS=["http://localhost:5173"]

# Agent 编排的 LLM 后端：
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 备用后端，把 LLM_PROVIDER 改成 anthropic 即可切过去
ANTHROPIC_API_KEY=
