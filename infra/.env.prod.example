# 复制为 infra/.env.prod（不要提交到 git），按需修改。
# docker-compose.prod.yml 里凡是没有默认值、写了 ${VAR:?...} 的字段，
# 这个文件里不填就直接拒绝启动——不会用弱密码悄悄跑起来。

# --- Postgres ---
POSTGRES_USER=caseflow
POSTGRES_PASSWORD=请改成一个真实的强密码
POSTGRES_DB=caseflow

# --- MinIO（对象存储，backend 会自动建 bucket，见 S3_BUCKET）---
S3_ACCESS_KEY=caseflow
S3_SECRET_KEY=请改成一个真实的强密码（至少8位，MinIO 的硬性要求）
S3_BUCKET=case-documents
S3_SECURE=false

# --- 鉴权 ---
# 一段足够长的随机字符串，用来签 JWT——泄露了等于谁都能伪造登录态。
# 生成一个的办法：`openssl rand -hex 32`
JWT_SECRET=请改成一个真实的随机长字符串
JWT_EXPIRE_MINUTES=720

# --- CORS ---
# 走 nginx 反代后前后端同源，这个字段实际上很少用到；仍然建议填成部署后
# 真实访问用的地址，给"有人想绕开 nginx 直连 backend 调试"这种场景留个
# 明确的口子，而不是留空或者写 *。
CORS_ORIGINS=["http://内部服务器地址或域名"]

# --- LLM 后端（Prompt 维护后台页面可以在 minimax/kimi 之间切换，不用
#     重启；这里只是启动时的兜底默认值，跟切换开关是两回事）---
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low

# 备用后端，把 LLM_PROVIDER 改成 anthropic 即可切过去
ANTHROPIC_API_KEY=

# --- 对外端口 ---
# 部署机器上这个端口要能被团队访问到（内网/VPN 范围内）。80 需要
# root/特权端口权限，改成别的（比如 8080）就不需要。
HTTP_PORT=80
